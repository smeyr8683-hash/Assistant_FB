# VST Assistant Team 0.2.0 - local publishing setup
# Setup copies this to .env.local only when that file does not exist.
VST_DATABASE_MODE=sqlite
NEXT_PUBLIC_APP_URL=https://localhost:3443

# Fill in your own Meta App and Login for Business Configuration IDs.
# Public IDs are not passwords. Never use another person's tokens or database.
FB_APP_ID=
NEXT_PUBLIC_FB_APP_ID=
NEXT_PUBLIC_FB_CONFIG_ID=
# Optional server-only secret for long-lived token exchange.
FB_APP_SECRET=

# Bot stays OFF. These defaults are intentional.
ENABLE_BOT_AUTOMATION=false
NEXT_PUBLIC_BOT_AUTOMATION_ENABLED=false
NEXT_PUBLIC_ENABLE_AUTO_SCANNER=false
ENABLE_FACEBOOK_WEBHOOK_SUBSCRIPTION=false

# Optional for AI caption generation; not needed for manual captions.
GEMINI_API_KEY=
